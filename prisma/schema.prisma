generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id            String   @id @db.Uuid
  email         String   @unique
  name          String?
  image         String?
  role          Role     @default(user)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

